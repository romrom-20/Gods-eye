  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gods Eye checkpoint artifact v1",
  "description": "Structural schema only; checkpoint_artifact.reload_artifact additionally enforces exact float32 roundtrip, content/tensor hashes, ordered replacement preconditions, instructions, and byte bound."
}
